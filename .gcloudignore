# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.git
.gitignore
node_modules
README.md
*.md
test/
.env*
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/cache/
.dockerignore
docker-compose.yml
Dockerfile.dev

